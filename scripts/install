#!/bin/bash

dotfiles_scripts="${HOME}/.dotfiles/scripts"
# shellcheck source=scripts/lib/utils
source "${dotfiles_scripts}/lib/utils"

"${dotfiles_scripts}/homebrew"

# Put Homebrew on PATH for the rest of this run. scripts/homebrew only does
# this inside its own process, so without it mise and everything else brew
# just installed are invisible to the scripts below.
if [[ $(uname -m) == "arm64" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
else
  eval "$(/usr/local/bin/brew shellenv)"
fi

# symlink must precede setup-mise: mise reads ~/.config/mise/config.toml,
# which is one of the links it creates.
"${dotfiles_scripts}/symlink"
"${dotfiles_scripts}/setup-macos"
"${dotfiles_scripts}/setup-mise"

# Git hooks live in .git/hooks, which is not cloned. Without this the
# pre-commit linters and the pre-push brew-drift check are silently absent.
e_header "Installing git hooks..."
lefthook install

printf "\n"
e_success "Setup complete!"
e_warning "Restart your shell to pick up mise activation"
