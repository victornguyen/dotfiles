#!/bin/bash

# shellcheck source=scripts/lib/utils
source "${HOME}/.dotfiles/scripts/lib/utils"

e_header "Setting up mise and runtimes..."

# Runtimes and global CLI tools are all declared in mise/config.toml,
# symlinked to ~/.config/mise/config.toml by scripts/symlink. Install
# everything from there rather than duplicating the list here.
e_header "Installing tools from mise/config.toml..."
mise install

e_success "mise setup complete!"
