#!/bin/bash
#
# Report drift between homebrew/Brewfile and what is actually installed.
#
# Drift is reported in both directions:
#   - declared in the Brewfile but not installed
#   - installed as a leaf but not declared
#
# Exits non-zero when there is drift, so it can gate a push or CI.
#
# Two deliberate omissions:
#
#   - `brew bundle check` is not used. It counts outdated packages as
#     unsatisfied, and this machine carries a large outdated backlog.
#     Reproducibility is about presence, not version currency.
#
#   - Mac App Store apps are not checked. Neither brew nor mas can
#     uninstall them, so any undeclared one would be permanent drift
#     with no way to resolve it.

set -uo pipefail

dotfiles="${HOME}/.dotfiles"
# shellcheck source=scripts/lib/utils
source "${dotfiles}/scripts/lib/utils"

brewfile="${dotfiles}/homebrew/Brewfile"

if [[ ! -f "${brewfile}" ]]; then
  e_error "No Brewfile at ${brewfile}"
  exit 2
fi

work="$(mktemp -d)"
trap 'rm -rf "${work}"' EXIT

# --- what the Brewfile declares (tap prefixes stripped) --------------------
grep -oE "^brew '[^']+'" "${brewfile}" | sed "s/brew '//;s/'//" | sed 's|.*/||' \
  | sort -u > "${work}/declared_formulae"
grep -oE "^cask '[^']+'" "${brewfile}" | sed "s/cask '//;s/'//" | sed 's|.*/||' \
  | sort -u > "${work}/declared_casks"

# --- what is installed -----------------------------------------------------
# All installed formulae, for the "declared but missing" direction: a declared
# formula may legitimately also be some other package's dependency.
brew list --formula | sed 's|.*/||' | sort -u > "${work}/installed_formulae"
# Leaves only, for the "installed but undeclared" direction: dependencies are
# pulled in automatically and need no declaration of their own.
brew leaves         | sed 's|.*/||' | sort -u > "${work}/leaf_formulae"
brew list --cask    | sed 's|.*/||' | sort -u > "${work}/installed_casks"

drift=0

# Resolve a declared formula name through its alias (gpg -> gnupg,
# python -> python@3.14) before calling it missing.
resolved_full_name() {
  local name="$1" full
  full="$(brew info --formula --json=v2 "${name}" 2>/dev/null \
    | python3 -c 'import json,sys
try:
    f = (json.load(sys.stdin).get("formulae") or [])
    print(f[0]["full_name"] if f else "")
except Exception:
    print("")' 2>/dev/null)"
  echo "${full##*/}"
}

report_missing() {
  local label="$1" declared="$2" installed="$3" resolve="$4" missing=()
  local item full
  while IFS= read -r item; do
    [[ -z "${item}" ]] && continue
    if [[ "${resolve}" == "resolve" ]]; then
      full="$(resolved_full_name "${item}")"
      if [[ -n "${full}" ]] && grep -qxF "${full}" "${installed}"; then
        # `python` declares `python@3.14`; record it so the undeclared
        # check below does not flag the very same package.
        echo "${full}" >> "${declared}"
        continue
      fi
    fi
    missing+=("${item}")
  done < <(comm -23 <(sort -u "${declared}") "${installed}")
  sort -u -o "${declared}" "${declared}"

  if (( ${#missing[@]} > 0 )); then
    drift=1
    e_warning "${label} declared but not installed (${#missing[@]}):"
    printf '    %s\n' "${missing[@]}"
  fi
}

report_undeclared() {
  local label="$1" installed="$2" declared="$3" extra=()
  local item
  while IFS= read -r item; do
    [[ -n "${item}" ]] && extra+=("${item}")
  done < <(comm -23 "${installed}" <(sort -u "${declared}"))

  if (( ${#extra[@]} > 0 )); then
    drift=1
    e_warning "${label} installed but not declared (${#extra[@]}):"
    printf '    %s\n' "${extra[@]}"
  fi
}

e_header "Checking Brewfile drift..."

report_missing "Formulae" "${work}/declared_formulae" "${work}/installed_formulae" resolve
report_missing "Casks"    "${work}/declared_casks"    "${work}/installed_casks"    no

report_undeclared "Formulae" "${work}/leaf_formulae"     "${work}/declared_formulae"
report_undeclared "Casks"    "${work}/installed_casks"   "${work}/declared_casks"

if (( drift == 0 )); then
  e_success "No drift. Brewfile matches the machine."
else
  printf "\n"
  e_error "Drift found. Install it, remove it, or declare it in homebrew/Brewfile."
fi

exit "${drift}"
