#!/bin/bash

dotfiles="${HOME}/.dotfiles"
# shellcheck source=scripts/lib/utils
source "${dotfiles}/scripts/lib/utils"

brew_pls() {
  # --no-upgrade: install what is missing, leave installed versions alone.
  # Same stance as scripts/brew-drift - presence, not version currency.
  brew bundle --no-upgrade --file="${dotfiles}/homebrew/$1"
}

# Install Xcode Command Line Tools...
if [[ $(command -v xcodebuild) == "" ]] ; then
  e_header "Installing command-line tools..."
  xcode-select --install
fi

# Install Homebrew
if [[ $(command -v brew) == "" ]] ; then
  e_header "Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  # Set up Homebrew environment for current session
  if [[ $(uname -m) == "arm64" ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  else
    eval "$(/usr/local/bin/brew shellenv)"
  fi

  brew analytics off

# Update Homebrew
else
  e_header "Updating Homebrew..."
  brew update
fi

# Install what the Brewfile declares. This runs on both paths on purpose: a
# machine that already had Homebrew still needs the packages, and `brew bundle`
# is a no-op for anything already installed.
e_header "Installing brews..."
brew_pls "Brewfile"

e_header "Checking for outdated brews..."
brew outdated
e_warning "Run \`brew upgrade\` to upgrade everything"
e_warning "Run \`brew upgrade <package_name>\` to upgrade specific packages"

e_success "Homebrew setup complete!"
