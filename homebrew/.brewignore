# Installed on this machine, deliberately not declared in the Brewfile.
#
# This file is what keeps `scripts/brew-drift` at zero. Without it every
# entry below reports as drift on each run.
#
# To actually remove any of these from the machine, see the optional
# uninstall list; delete the entry from here at the same time.
#
# Format: one entry per line. Formulae and casks by name, Mac App Store
# apps by numeric id. `#` begins a comment.

# --- Superseded formulae ---
exa                     # -> eza
fasd                    # -> zoxide
chruby                  # -> mise
ruby-install            # -> mise
docker-machine          # upstream archived 2021
python@3.10             # -> python@3.14
python@3.11             # -> python@3.14

# --- Undeclared by choice, still installed ---
vim                     # neovim is the editor everywhere
ranger                  # unmaintained
fpp                     # superseded by tmux copy-mode + fzf
mysql                   # nothing in the dotfiles references it

# --- Orphaned or unwanted formulae ---
dolt                    # beads backend, orphaned when beads was removed
switchaudio-osx
perl
open-mpi
summarize
gogcli
evernote-backup
yarn                    # -> pnpm via mise

# --- Window managers retired in favour of aerospace ---
amethyst
rectangle
hammerspoon
karabiner-elements

# --- Pruned casks ---
cmux
codexbar
dash
hazel
licecap
quicklook-json
sketch
evernote
flux
flux-app
google-chrome-canary
google-chrome@canary
marked                  # dup of declared marked-app
alfred                  # -> raycast
postman                 # charles + insomnia are the declared HTTP clients
xurl

